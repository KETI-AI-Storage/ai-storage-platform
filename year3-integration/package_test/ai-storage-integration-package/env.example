# AI Storage 통합 패키지 환경변수 예시.
#
# setup.sh / verify.sh / uninstall.sh는 동일한 변수 이름을 사용한다.
# 실행 전 `cp env.example env && vi env`로 값을 조정하고
# `set -a; source env; set +a`로 export한 뒤 스크립트를 호출한다.

# AI Storage 워크로드를 배치할 Namespace. webhook은 이 namespace에 한해
# keti-ai-storage-injection=enabled 라벨 기반 mutation을 수행한다.
TARGET_NAMESPACE=ai-storage-workloads

# webhook / scheduler가 배치되는 Namespace. ai-storage-scheduler manifest는 keti를 가정한다.
WEBHOOK_NAMESPACE=keti

# CIFAR-10 / 추가 전처리 워크로드 예제 매니페스트를 함께 apply 할지 여부.
APPLY_WORKLOAD_EXAMPLES=false

# 폐쇄망에서 images/tar/*.tar를 import 할지 여부.
IMPORT_IMAGES=false

# 이미지 tar 파일이 위치한 디렉터리.
IMAGE_DIR=images/tar

# 컨테이너 런타임(auto|ctr|docker). auto는 ctr → docker 순서로 자동 감지한다.
CONTAINER_RUNTIME=auto

# uninstall.sh 안전 가드. true 로 설정해야 실제 삭제가 실행된다.
DELETE_WORKLOADS=false
DELETE_CORE=false
DELETE_STORAGECLASS=false
DELETE_NAMESPACE=false
